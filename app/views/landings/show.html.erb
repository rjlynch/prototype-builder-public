<div class="govuk-width-container">
  <main class="govuk-main-wrapper" id="main-content">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Prototype GOV.UK services without writing code</h1>
        <p class="govuk-body">
          Build page-by-page journeys with a live preview, then share a link
          with colleagues and users for feedback. No prototype kit, no code,
          no hosting to sort out.
        </p>
        <p class="govuk-body">
          <%= link_to "Read the documentation", documentation_path, class: "govuk-link" %>
          to learn what you can build and how the editor works.
        </p>
        <%= link_to "Create an account", new_sign_up_path, class: "govuk-button", role: "button",
              draggable: "false", data: { module: "govuk-button" } %>
        <p class="govuk-body">
          Already have an account? <%= link_to "Sign in", new_sign_in_path, class: "govuk-link" %>.
        </p>
      </div>
    </div>
  </main>
</div>
