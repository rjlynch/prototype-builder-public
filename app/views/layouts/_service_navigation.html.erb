<section aria-label="Service information" class="govuk-service-navigation" data-module="govuk-service-navigation">
  <div class="govuk-width-container">
    <div class="govuk-service-navigation__container">
      <span class="govuk-service-navigation__service-name">
        <%= link_to "Prototype Builder", root_path, class: "govuk-service-navigation__link" %>
      </span>
      <%# Pages set this (via content_for) to show the thing being edited —
          e.g. the wizard name links back to its settings from the builder. %>
      <% if content_for?(:service_navigation_context) %>
        <span class="app-service-navigation__context">
          <span class="app-service-navigation__separator" aria-hidden="true">&rsaquo;</span>
          <%= yield :service_navigation_context %>
        </span>
      <% end %>
      <% if signed_in %>
        <nav aria-label="Menu" class="govuk-service-navigation__wrapper">
          <ul class="govuk-service-navigation__list">
            <li class="govuk-service-navigation__item">
              <%= link_to "Your wizards", wizards_path, class: "govuk-service-navigation__link" %>
            </li>
            <li class="govuk-service-navigation__item">
              <%= button_to "Sign out", session_path, method: :delete, class: "govuk-service-navigation__link app-button-as-link" %>
            </li>
          </ul>
        </nav>
      <% end %>
    </div>
  </div>
</section>
