<div id="<%= dom_id(branch_rule, :editor) %>" class="app-rule">
  <% input_choices = branch_rule.component.page.wizard.input_choices %>
  <% if input_choices.none? %>
    <p class="govuk-hint">
      This wizard has no inputs yet. Add a text input, radio buttons or
      checkboxes, then you can branch on the answer.
    </p>
  <% else %>
    <%# A rule's conditions are ANDed: all must hold for the rule to fire. %>
    <% branch_rule.conditions.each_with_index do |condition, index| %>
      <%= render "conditions/editor", condition: condition,
            first: index.zero?, removable: branch_rule.conditions.many? %>
    <% end %>
    <%= button_to "Add condition", branch_rule_conditions_path(branch_rule),
          class: "app-button-as-link govuk-link app-rule__add-condition" %>

    <%# Namespace the form so the target field (and its label's `for`) gets a
        rule-scoped id; without this every rule shares "branch_rule_target_slug"
        and autosubmit focus restore jumps to the first rule. %>
    <%= form_with model: BranchRuleForm.from_branch_rule(branch_rule), url: branch_rule_path(branch_rule), method: :patch,
          namespace: dom_id(branch_rule),
          data: { controller: "autosubmit", action: "turbo:submit-end->autosubmit#saved" } do |f| %>
      <div class="govuk-form-group">
        <%= f.label :target_slug, "Go to page", class: "govuk-label" %>
        <%= f.text_field :target_slug, class: "govuk-input", data: { action: "input->autosubmit#submit" } %>
        <%= render "branch_rules/missing_target", branch_rule: branch_rule %>
      </div>
      <%= render "shared/autosubmit_status" %>
    <% end %>
  <% end %>
  <%= button_to "Remove rule", branch_rule_path(branch_rule), method: :delete, class: "app-button-as-link govuk-link" %>
</div>
