<%# The page's own settings, as a collapsible card alongside the component
    editors. The caption sits inside the form (always visible while the card
    is open); the slug stays tucked in its own disclosure since it rarely
    changes. %>
<details id="<%= dom_id(page, :title_card) %>" class="app-card" open
         data-controller="persisted-details mirror" data-action="toggle->persisted-details#store">
  <summary class="app-card__summary">
    <h3 class="govuk-heading-s app-card__title">Page</h3>
    <span class="app-card__snippet govuk-body-s" data-mirror-target="output"><%= page.title %></span>
  </summary>

  <% if page.wizard.pages.many? %>
    <div class="app-card__actions">
      <%= button_to(
        "Remove this page",
        page_path(page),
        method: :delete,
        class: "app-button-as-link govuk-link app-link--danger",
        form: {
          data: {
            turbo_confirm: "Are you sure you want to delete this page"
          }
        }
      ) %>
    </div>
  <% end %>

  <%= form_with model: PageForm.new(page), url: page_path(page), method: :patch,
        data: { controller: "autosubmit", action: "turbo:submit-end->autosubmit#saved" } do |f| %>
    <div class="govuk-form-group">
      <label class="govuk-label" for="page_form_title">Page title</label>
      <%= f.text_field :title, id: "page_form_title", class: "govuk-input",
            data: { mirror_target: "source", action: "input->autosubmit#submit input->mirror#refresh" } %>
    </div>
    <div class="govuk-form-group app-heading-size">
      <%= f.label :heading_size, "Heading size", class: "govuk-label govuk-label--s" %>
      <% size_labels = { "xl" => "Extra large", "l" => "Large", "m" => "Medium", "s" => "Small" } %>
      <%= f.select :heading_size, Page::HEADING_SIZES.map { |size| [size_labels[size], size] },
            {}, class: "govuk-select", data: { action: "change->autosubmit#submit" } %>
    </div>
    <div class="govuk-form-group">
      <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Panel</legend>
        <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
          <% { "none" => "No panel", "success" => "Success (green)", "information" => "Information (blue)" }.each do |value, text| %>
            <div class="govuk-radios__item">
              <%= f.radio_button :panel_style, value, id: dom_id(page, :"panel_style_#{value}"),
                    class: "govuk-radios__input", data: { action: "change->autosubmit#submit" } %>
              <%= f.label :panel_style, text, value: value, for: dom_id(page, :"panel_style_#{value}"),
                    class: "govuk-label govuk-radios__label" %>
            </div>
          <% end %>
        </div>
      </fieldset>
    </div>
    <%= render "shared/autosubmit_status" %>
  <% end %>

  <%= render "pages/caption_form", page: page %>
  <%= render "pages/back_link_form", page: page %>
  <%= render "pages/slug_form", page: page %>
</details>
