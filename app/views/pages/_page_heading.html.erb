<div id="<%= dom_id(page, :page_heading) %>" class="app-builder-heading">
  <span class="govuk-caption-m app-builder-heading__wizard">
    <%= link_to page.wizard.name, edit_wizard_path(page.wizard), class: "govuk-link govuk-link--muted" %>
    <%= link_to edit_wizard_path(page.wizard), class: "app-icon-link govuk-link govuk-link--muted", aria: { label: "Wizard settings" } do %>
      <%= svg_icon("cog") %>
    <% end %>
    <%= link_to "Share this wizard", wizard_path(page.wizard), class: "govuk-link", target: "_blank", rel: "noopener" %>
    <span aria-hidden="true">·</span>
    <button type="button"
            class="app-button-as-link govuk-link"
            data-controller="clipboard"
            data-clipboard-text-value="<%= wizard_url(page.wizard) %>"
            data-action="clipboard#copy">
      <span data-clipboard-target="label">Copy link</span>
    </button>
  </span>
</div>
