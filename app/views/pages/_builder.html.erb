<div id="<%= dom_id(page, :builder) %>">
  <span class="govuk-caption-m"><%= page.wizard.name %></span>
  <h2 class="govuk-heading-m">Page <%= page.position %></h2>

  <p class="govuk-body">
    <%= link_to "Share this wizard", wizard_path(page.wizard), class: "govuk-link", target: "_blank", rel: "noopener" %>
  </p>

  <%= form_with model: PageForm.from_page(page), url: page_path(page), method: :patch, data: { controller: "autosubmit" } do |f| %>
    <div class="govuk-form-group">
      <%= f.label :title, "Page title", class: "govuk-label" %>
      <%= f.text_field :title, class: "govuk-input", data: { action: "input->autosubmit#submit" } %>
    </div>
  <% end %>

  <% page.components.each do |component| %>
    <%= render "components/editor", component: component %>
  <% end %>

  <div class="govuk-button-group">
    <%= button_to "Add paragraph", page_components_path(page),
          params: { component: { kind: "paragraph" } },
          class: "govuk-button govuk-button--secondary" %>
    <%= button_to "Add continue button", page_components_path(page),
          params: { component: { kind: "button" } },
          class: "govuk-button govuk-button--secondary" %>
  </div>

  <details class="govuk-details">
    <summary class="govuk-details__summary">
      <span class="govuk-details__summary-text">Add input</span>
    </summary>
    <div class="govuk-details__text">
      <%= button_to "Text input", page_components_path(page),
            params: { component: { kind: "text_input" } },
            class: "govuk-button govuk-button--secondary" %>
    </div>
  </details>
</div>
