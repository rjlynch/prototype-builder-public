<div id="<%= dom_id(page, :page_controls) %>">
  <details class="app-disclosure">
    <summary class="app-disclosure__summary">
      Page controls <span class="app-disclosure__value"><%= page.slug %></span>
    </summary>

    <%= form_with model: PageForm.new(page), url: page_path(page), method: :patch,
          data: { controller: "autosubmit", action: "turbo:submit-end->autosubmit#saved" } do |f| %>
      <div class="govuk-form-group">
        <%= f.label :slug, "Page slug", class: "govuk-label" %>
        <div class="govuk-hint">Used to link pages together. Tracks the title until you change it.</div>
        <%= f.text_field :slug, class: "govuk-input", data: { action: "input->autosubmit#submit" } %>
      </div>
      <%= render "shared/autosubmit_status" %>
    <% end %>

    <%# Reordering and inserting/removing the page within the journey. Move
        buttons drop off at the ends; remove is hidden when it is the last page. %>
    <div class="app-button-stack">
      <% if page.position > 1 %>
        <%= button_to "Move page back", page_position_path(page), method: :patch,
              params: { position: page.position - 1 },
              class: "govuk-button govuk-button--secondary" %>
      <% end %>
      <% if page.position < page.wizard.pages.size %>
        <%= button_to "Move page forward", page_position_path(page), method: :patch,
              params: { position: page.position + 1 },
              class: "govuk-button govuk-button--secondary" %>
      <% end %>
      <%= button_to "Add page after", page_successor_path(page),
            class: "govuk-button govuk-button--secondary" %>
      <% if page.wizard.pages.many? %>
        <%= button_to "Remove this page", page_path(page), method: :delete,
              class: "govuk-button govuk-button--warning",
              form: { data: { turbo_confirm: "Are you sure you want to delete this page" } } %>
      <% end %>
    </div>
  </details>
</div>
