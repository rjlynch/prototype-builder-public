<% pages = local_assigns.fetch(:pages, page.wizard.pages) %>
<% current_page = local_assigns.fetch(:current_page, page) %>
<% reference_page = local_assigns.fetch(:page, pages.first) %>

<%# Each page is a tab linking to its builder. The current page is the
    selected tab. Per-tab controls reorder the page within the journey
    (drag-to-reorder will replace the arrows later). %>
<nav id="<%= dom_id(reference_page, :pages_nav) %>"
     class="govuk-tabs app-page-tabs" aria-label="Pages in this wizard"
     data-controller="tab-overflow">
  <ul class="govuk-tabs__list" data-tab-overflow-target="list">
    <% pages.each do |other| %>
      <% name = other.title.presence || other.slug %>
      <% selected = current_page.present? && other == current_page %>
      <li class="govuk-tabs__list-item <%= "govuk-tabs__list-item--selected" if selected %>"
          <%= "data-tab-overflow-target=selected".html_safe if selected %>>
        <%= link_to name.first(5), edit_page_path(other), class: "govuk-tabs__tab" %>
        <span class="app-tab-controls">
          <% if other.position > 1 %>
            <%= button_to page_position_path(other), method: :patch,
                  params: { position: other.position - 1 },
                  class: "app-icon-button", form_class: "app-tab-controls__form" do %>
              <span aria-hidden="true">&larr;</span>
              <span class="govuk-visually-hidden">Move <%= name %> earlier</span>
            <% end %>
          <% end %>
          <% if other.position < pages.size %>
            <%= button_to page_position_path(other), method: :patch,
                  params: { position: other.position + 1 },
                  class: "app-icon-button", form_class: "app-tab-controls__form" do %>
              <span aria-hidden="true">&rarr;</span>
              <span class="govuk-visually-hidden">Move <%= name %> later</span>
            <% end %>
          <% end %>
          <%= button_to page_successor_path(other),
                class: "app-icon-button", form_class: "app-tab-controls__form" do %>
            <%= svg_icon("plus") %>
            <span class="govuk-visually-hidden">Add a page after <%= name %></span>
          <% end %>
        </span>
      </li>
    <% end %>

    <%# Overflow arrows: server-rendered but hidden, revealed by the controller
        when the tabs spill off the row, each pointing at the nearest hidden
        page. They're rendered after the tabs (so they don't shift the tabs'
        nth-child positions); the controller and flex `order` place the
        "previous" arrow at the front of the visible run. %>
    <li class="govuk-tabs__list-item app-page-tabs__overflow app-page-tabs__overflow--previous"
        data-tab-overflow-target="previous" hidden>
      <a class="govuk-tabs__tab" href="#">
        <span aria-hidden="true">&#9664;</span>
        <span class="govuk-visually-hidden">Show earlier pages</span>
      </a>
    </li>
    <li class="govuk-tabs__list-item app-page-tabs__overflow"
        data-tab-overflow-target="next" hidden>
      <a class="govuk-tabs__tab" href="#">
        <span aria-hidden="true">&#9654;</span>
        <span class="govuk-visually-hidden">Show more pages</span>
      </a>
    </li>
  </ul>
</nav>
