<% pages = local_assigns.fetch(:pages, page.wizard.pages) %>
<% current_page = local_assigns.fetch(:current_page, page) %>
<% reference_page = local_assigns.fetch(:page, pages.first) %>

<%# Each page is a tab linking to its builder. The current page is the
    selected tab. Per-tab controls reorder the page within the journey
    (drag-to-reorder will replace the arrows later). %>
<nav id="<%= dom_id(reference_page, :pages_nav) %>"
     class="govuk-tabs app-page-tabs" aria-label="Pages in this wizard">
  <ul class="govuk-tabs__list">
    <% pages.each do |other| %>
      <% name = other.title.presence || other.slug %>
      <li class="govuk-tabs__list-item <%= "govuk-tabs__list-item--selected" if current_page.present? && other == current_page %>">
        <%= link_to name.first(5), edit_page_path(other), class: "govuk-tabs__tab" %>
        <span class="app-tab-controls">
          <% if other.position > 1 %>
            <%= button_to page_position_path(other), method: :patch,
                  params: { position: other.position - 1 },
                  class: "app-icon-button", form_class: "app-tab-controls__form" do %>
              <span aria-hidden="true">&uarr;</span>
              <span class="govuk-visually-hidden">Move <%= name %> earlier</span>
            <% end %>
          <% end %>
          <% if other.position < pages.size %>
            <%= button_to page_position_path(other), method: :patch,
                  params: { position: other.position + 1 },
                  class: "app-icon-button", form_class: "app-tab-controls__form" do %>
              <span aria-hidden="true">&darr;</span>
              <span class="govuk-visually-hidden">Move <%= name %> later</span>
            <% end %>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
</nav>
