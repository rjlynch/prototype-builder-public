<% pages = local_assigns.fetch(:pages, page.wizard.pages) %>
<% current_page = local_assigns.fetch(:current_page, page) %>
<% reference_page = local_assigns.fetch(:page, pages.first) %>
<% max_tabs = local_assigns.fetch(:max_tabs, ApplicationHelper::TAB_WINDOW_SIZE) %>
<% window = tab_window(pages, current_page, per: max_tabs) %>

<%# Each page is a tab linking to its builder. The current page is the selected
    tab; its reorder/insert/remove controls live in the page panel rather than
    the tab. Only the block of tabs around the current page is shown; if more
    pages sit on either side, an arrow leads to them. %>
<nav id="<%= dom_id(reference_page, :pages_nav) %>"
     class="govuk-tabs app-page-tabs" aria-label="Pages in this wizard">
  <ul class="govuk-tabs__list">
    <% if window.previous %>
      <li class="govuk-tabs__list-item app-page-tabs__overflow">
        <%= link_to edit_page_path(window.previous), class: "govuk-tabs__tab" do %>
          <%= svg_icon("chevron-left") %>
          <span class="govuk-visually-hidden">Show earlier pages</span>
        <% end %>
      </li>
    <% end %>

    <% window.items.each do |other| %>
      <% name = other.title.presence || other.slug %>
      <% selected = current_page.present? && other == current_page %>
      <li class="govuk-tabs__list-item <%= "govuk-tabs__list-item--selected" if selected %>">
        <%= link_to name.first(5), edit_page_path(other), class: "govuk-tabs__tab" %>
      </li>
    <% end %>

    <% if window.next %>
      <li class="govuk-tabs__list-item app-page-tabs__overflow">
        <%= link_to edit_page_path(window.next), class: "govuk-tabs__tab" do %>
          <%= svg_icon("chevron-right") %>
          <span class="govuk-visually-hidden">Show more pages</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
