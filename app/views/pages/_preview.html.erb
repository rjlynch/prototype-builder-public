<div id="<%= dom_id(page, :preview) %>" class="app-preview">
  <div class="govuk-width-container">
    <%= render "pages/back_link", page: page, mode: mode %>
    <div class="govuk-main-wrapper">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <%# When an input renders the title as its label/legend (the GOV.UK
              single-question pattern), it owns the H1 — don't render it twice. %>
          <% if page.title.present? && page.heading_component.nil? %>
            <%= render "pages/preview_caption", page: page %>
            <h1 class="<%= page.heading_class %>"><%= page.title %></h1>
          <% end %>
          <% if mode == :builder && page.title.blank? && page.components.none? %>
            <p class="govuk-body app-empty-state">
              Your page preview appears here — start by adding a title.
            </p>
          <% end %>
          <%= form_with url: page_answers_path(page), method: :post do %>
            <%= hidden_field_tag :mode, mode %>
            <% page.components.each do |component| %>
              <%= render "components/previews/#{component.kind}", component: component, mode: mode %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
