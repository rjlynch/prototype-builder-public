<%# answers: the journey's stored answers, threaded through so playback
    components (e.g. a file) can render what was entered earlier. Empty in the
    builder, where there are no real answers. %>
<% answers = local_assigns.fetch(:answers, {}) %>
<%# When the user arrived here from a check-answers Change link, return_to holds
    the summary page's slug; carried as a hidden field so the answers controller
    sends them back to it on Continue rather than following normal navigation. %>
<% return_to = local_assigns.fetch(:return_to, nil) %>
<div id="<%= dom_id(page, :preview) %>" class="app-preview">
  <div class="govuk-width-container">
    <%= render "pages/back_link", page: page %>
    <div class="govuk-main-wrapper">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <%# The page H1 sits at the top, with an id so an input using it as its
              label can reference it (aria-labelledby). A text input renders it
              inline as its own <label>, so it is not repeated here. A panel, when
              set, owns the H1 instead and renders first. %>
          <% if page.panel? %>
            <%= render "pages/panel", page: page, mode: mode %>
          <% elsif page.title.present? && !page.heading_rendered_inline? %>
            <%= render "pages/preview_caption", page: page %>
            <h1 id="<%= dom_id(page, :heading) %>" class="<%= page.heading_class %>"><%= page.title %></h1>
          <% end %>
          <% if mode == :builder && page.title.blank? && page.components.none? %>
            <p class="govuk-body app-empty-state">
              Your page preview appears here — start by adding a title.
            </p>
          <% end %>
          <%= form_with url: page_answers_path(page), method: :post, multipart: page.accepts_uploads? do %>
            <%= hidden_field_tag :mode, mode %>
            <%= hidden_field_tag :return_to, return_to if return_to.present? %>
            <% page.body_components.each do |component| %>
              <%= render "components/previews/#{component.kind}", component: component, mode: mode, answers: answers %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
