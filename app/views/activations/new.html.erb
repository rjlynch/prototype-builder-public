<div class="govuk-width-container">
  <main class="govuk-main-wrapper" id="main-content">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Confirm your account</h1>
        <p class="govuk-body">Select the button to finish creating your account.</p>

        <%= form_with url: activation_path, method: :post do |f| %>
          <%= hidden_field_tag :token, @token %>
          <%= f.submit "Create account", class: "govuk-button" %>
        <% end %>
      </div>
    </div>
  </main>
</div>
