<div id="<%= dom_id(component, :editor) %>" class="app-card">
  <div class="app-card__header">
    <h3 class="govuk-heading-s app-card__title"><%= component.kind.humanize %></h3>
    <%= button_to component_path(component), method: :delete, class: "app-button-as-link govuk-link" do %>
      Remove<span class="govuk-visually-hidden"> <%= component.kind.humanize.downcase %></span>
    <% end %>
  </div>

  <%= form_with model: ComponentForm.from_component(component), url: component_path(component), method: :patch, data: { controller: "autosubmit" } do |f| %>
    <%= render "components/editors/#{component.kind}", f: f %>
  <% end %>

  <%= render "components/branching", component: component if component.kind == "button" %>
</div>
