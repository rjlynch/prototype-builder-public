<details id="<%= dom_id(component, :editor) %>" class="app-card" open
         data-controller="persisted-details mirror" data-action="toggle->persisted-details#store">
  <summary class="app-card__summary">
    <h3 class="govuk-heading-s app-card__title"><%= component.display_name %></h3>
    <span class="app-card__snippet govuk-body-s" data-mirror-target="output"><%= component.summary_text %></span>
  </summary>

  <div class="app-card__actions">
    <%= button_to component_path(component), method: :delete, class: "app-button-as-link govuk-link" do %>
      Remove<span class="govuk-visually-hidden"> <%= component.display_name.downcase %></span>
    <% end %>
  </div>

  <%= form_with model: ComponentForm.from_component(component), url: component_path(component), method: :patch, data: { controller: "autosubmit" } do |f| %>
    <%= render "components/editors/#{component.kind}", f: f %>
  <% end %>

  <%= render "components/branching", component: component if component.kind == "button" %>
</details>
