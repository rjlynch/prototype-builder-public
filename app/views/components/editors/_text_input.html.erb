<div class="govuk-form-group">
  <%= f.label :name, "Name", class: "govuk-label" %>
  <div class="govuk-hint">Used internally to identify the answer</div>
  <%= f.text_field :name, class: "govuk-input", data: { action: "input->autosubmit#submit" } %>
</div>
<div class="govuk-form-group">
  <%= f.label :label, "Label", class: "govuk-label" %>
  <%= f.text_field :label, class: "govuk-input", data: { action: "input->autosubmit#submit input->mirror#refresh", mirror_target: "source" } %>
</div>
<div class="govuk-form-group">
  <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
    <div class="govuk-checkboxes__item">
      <%= f.check_box :title_as_label, id: dom_id(f.object.component, :title_as_label),
            class: "govuk-checkboxes__input", data: { action: "change->autosubmit#submit" } %>
      <%= f.label :title_as_label, "Use the page title as the label", for: dom_id(f.object.component, :title_as_label),
            class: "govuk-label govuk-checkboxes__label" %>
    </div>
  </div>
</div>
<div class="govuk-form-group">
  <%= f.label :hint, "Hint", class: "govuk-label" %>
  <%= f.text_field :hint, class: "govuk-input", data: { action: "input->autosubmit#submit" } %>
</div>
