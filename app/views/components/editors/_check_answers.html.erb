<%# Picks which earlier questions this summary list plays back: a checklist of
    the wizard's inputs in journey order. The ticked keys submit as
    summary_keys[] and are stored one per line (ComponentForm joins them). The
    empty hidden field keeps the key present when every box is unticked, so
    clearing the list replaces the previous selection. %>
<% editor = f.object.component %>
<% inputs = editor.page.wizard.input_index %>
<% selected = editor.summary_input_keys %>
<div class="govuk-form-group">
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Questions to show</legend>
    <% if inputs.any? %>
      <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
        <%= hidden_field_tag "component[summary_keys][]", "" %>
        <% inputs.each do |key, input| %>
          <% id = dom_id(editor, "summary_#{key}") %>
          <div class="govuk-checkboxes__item">
            <%= check_box_tag "component[summary_keys][]", key, selected.include?(key),
                  id: id, class: "govuk-checkboxes__input",
                  data: { action: "change->autosubmit#submit" } %>
            <%= label_tag id, input.label.presence || input.page.title.presence || key,
                  class: "govuk-label govuk-checkboxes__label" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="govuk-hint">Add some questions on earlier pages first.</p>
    <% end %>
  </fieldset>
</div>
