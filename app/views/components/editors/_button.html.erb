<div class="govuk-form-group">
  <%= f.label :text, "Button text", class: "govuk-label" %>
  <%= f.text_field :text, class: "govuk-input", data: { action: "input->autosubmit#submit input->mirror#refresh", mirror_target: "source" } %>
</div>
<div class="govuk-form-group">
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Type</legend>
    <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
      <% { "continue" => "Continue (default)", "secondary" => "Secondary", "inverse" => "Inverse", "start" => "Start", "warning" => "Warning" }.each do |value, text| %>
        <div class="govuk-radios__item">
          <%= f.radio_button :button_style, value, id: dom_id(f.object.component, :"button_style_#{value}"),
                class: "govuk-radios__input", data: { action: "change->autosubmit#submit" } %>
          <%= f.label :button_style, text, value: value, for: dom_id(f.object.component, :"button_style_#{value}"),
                class: "govuk-label govuk-radios__label" %>
        </div>
      <% end %>
    </div>
  </fieldset>
</div>
<div class="govuk-form-group">
  <%= f.label :target_slug, "Go to page", class: "govuk-label" %>
  <div class="govuk-hint" id="<%= dom_id(f.object.component, :target_slug_hint) %>">
    The page slug this button goes to. Leave blank to continue to the next
    page. A matching branch rule below takes priority.
  </div>
  <%= f.text_field :target_slug, class: "govuk-input",
        aria: { describedby: dom_id(f.object.component, :target_slug_hint) },
        list: dom_id(f.object.component, :slugs),
        data: { action: "input->autosubmit#submit" } %>
  <%= render "shared/slug_datalist", id: dom_id(f.object.component, :slugs), slugs: f.object.component.page.wizard.page_slugs %>
  <%= render "components/missing_target", component: f.object.component %>
</div>
