<div class="govuk-form-group">
  <%# When the radios use the page title as their legend, the H1 is rendered at
      the top of the page and referenced here with aria-labelledby — so copy can
      sit between the heading and the options (issue #74). %>
  <fieldset class="govuk-fieldset"
            <%= %(aria-labelledby="#{dom_id(component.page, :heading)}").html_safe if component.page_heading? %>
            <%= %(aria-describedby="#{dom_id(component, :preview_hint)}").html_safe if component.hint.present? %>>
    <% if !component.page_heading? && component.label.present? %>
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
        <%= component.label %>
      </legend>
    <% end %>
    <% if component.hint.present? %>
      <div class="govuk-hint" id="<%= dom_id(component, :preview_hint) %>">
        <%= component.hint %>
      </div>
    <% end %>
    <div class="govuk-radios<%= " govuk-radios--inline" if component.inline? %>" data-module="govuk-radios">
      <% component.option_list.each_with_index do |option, index| %>
        <div class="govuk-radios__item">
          <input class="govuk-radios__input"
                 id="<%= dom_id(component, :"preview_option_#{index}") %>"
                 name="answers[<%= component.input_key %>]"
                 type="radio"
                 value="<%= option.parameterize %>">
          <label class="govuk-label govuk-radios__label" for="<%= dom_id(component, :"preview_option_#{index}") %>">
            <%= option %>
          </label>
        </div>
      <% end %>
    </div>
  </fieldset>
</div>
