<% dead_end = mode == :run && component.page.next.nil? && component.branch_rules.none?(&:complete?) %>
<button type="submit"
        name="button_id"
        value="<%= component.id %>"
        class="govuk-button <%= component.button_modifier_class %>"
        data-module="govuk-button"
        <%= "disabled" if dead_end %>>
  <%= component.text %>
  <% if component.start_button? %>
    <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
    </svg>
  <% end %>
</button>

<% if dead_end %>
  <div class="govuk-inset-text">
    This is the end of the prototype.
  </div>
<% end %>
