<% dead_end = mode == :run && component.page.next.nil? && component.branch_rules.none?(&:complete?) %>
<button type="submit"
        name="button_id"
        value="<%= component.id %>"
        class="govuk-button"
        data-module="govuk-button"
        <%= "disabled" if dead_end %>>
  <%= component.text %>
</button>

<% if dead_end %>
  <div class="govuk-inset-text">
    This is the end of the prototype.
  </div>
<% end %>
