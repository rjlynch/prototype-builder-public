<% if mode == :builder %>
  <%# While building, continue takes you to the next page's builder (creating it if needed) %>
  <%= button_to component.text, wizard_pages_path(component.page.wizard),
        params: { after_id: component.page.id },
        class: "govuk-button" %>
<% elsif component.page.next %>
  <%= link_to component.text, page_path(component.page.next), class: "govuk-button" %>
<% else %>
  <button type="button" class="govuk-button" disabled><%= component.text %></button>
<% end %>
