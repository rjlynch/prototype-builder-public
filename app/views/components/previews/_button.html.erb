<% dead_end = mode == :run && component.page.next.nil? && component.branch_rules.none?(&:complete?) %>
<button type="submit"
        name="button_id"
        value="<%= component.id %>"
        class="govuk-button"
        data-module="govuk-button"
        <%= "disabled" if dead_end %>>
  <%= component.text %>
</button>

<% if dead_end %>
  <div class="govuk-inset-text">
    This is the end of the prototype.
  </div>
<% end %>

<% if mode == :builder && component.branch_rules.any?(&:complete?) %>
  <p class="app-annotation">
    <% component.branch_rules.select(&:complete?).each do |rule| %>
      if <%= rule.input_name %> is “<%= rule.value %>” go to <%= rule.target_slug %><br>
    <% end %>
    otherwise continue to the next page
  </p>
<% end %>
