<%# The condition controller repopulates the answer datalist from this map when
    the question changes, so a fixed-answer question (radios/checkboxes) offers
    its answers and a free-text question leaves the field free text. %>
<div id="<%= dom_id(condition, :editor) %>" class="app-condition"
     data-controller="condition"
     data-condition-options-value="<%= condition.branch_rule.component.page.wizard.answer_options.to_json %>">
  <%# Namespace the form so every field (and its label's `for`) gets a
      condition-scoped id. Without this, all conditions share ids like
      "condition_value"; after an autosubmit Turbo restores focus by id and
      lands on the first match, jumping focus to the wrong condition. %>
  <%= form_with model: ConditionForm.from_condition(condition), url: condition_path(condition), method: :patch,
        namespace: dom_id(condition),
        data: { controller: "autosubmit", action: "turbo:submit-end->autosubmit#saved" } do |f| %>
    <div class="govuk-form-group">
      <%= f.label :input_name, first ? "When answer to" : "And answer to", class: "govuk-label" %>
      <%= f.select :input_name,
            condition.branch_rule.component.page.wizard.input_choices,
            { include_blank: true },
            class: "govuk-select",
            data: { action: "change->autosubmit#submit change->condition#refresh", condition_target: "question" } %>
    </div>
    <div class="govuk-form-group">
      <%= f.label :value, "Is", class: "govuk-label" %>
      <%= f.text_field :value, class: "govuk-input", list: dom_id(condition, :answers),
            data: { action: "input->autosubmit#submit" } %>
      <datalist id="<%= dom_id(condition, :answers) %>" data-condition-target="list"></datalist>
    </div>
    <%= render "shared/autosubmit_status" %>
  <% end %>
  <%# The first condition is removed by removing the whole rule, so a rule
      always keeps at least one condition. %>
  <% if removable %>
    <%= button_to "Remove condition", condition_path(condition), method: :delete, class: "app-button-as-link govuk-link" %>
  <% end %>
</div>
