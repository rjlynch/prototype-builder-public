<div class="govuk-width-container">
  <%= link_to "Back to the builder", edit_page_path(wizard.pages.first!), class: "govuk-back-link" %>

  <main class="govuk-main-wrapper" id="main-content">
    <span class="govuk-caption-l">Wizard settings</span>
    <%= render "wizards/name_heading", wizard: wizard %>

    <p class="govuk-body-s">
      <%= link_to "Share this wizard", wizard_path(wizard), class: "govuk-link", target: "_blank", rel: "noopener" %>
      <span aria-hidden="true">·</span>
      <button type="button"
              class="app-button-as-link govuk-link"
              data-controller="clipboard"
              data-clipboard-text-value="<%= wizard_url(wizard) %>"
              data-action="clipboard#copy">
        <span data-clipboard-target="label">Copy link</span>
      </button>
    </p>

    <%= form_with model: WizardNameForm.from_wizard(wizard), url: wizard_path(wizard), method: :patch,
          data: { controller: "autosubmit", action: "turbo:submit-end->autosubmit#saved" } do |f| %>
      <div class="govuk-form-group">
        <%= f.label :name, "Wizard name", class: "govuk-label" %>
        <div class="govuk-hint">Shown on your dashboard and at the top of the builder. Saves as you type.</div>
        <%= f.text_field :name, class: "govuk-input", data: { action: "input->autosubmit#submit" } %>
      </div>
      <%= render "shared/autosubmit_status" %>
    <% end %>

    <%= render "pages/pages_nav", pages: wizard.pages, current_page: nil, page: wizard.pages.first!, stacked: true %>
  </main>
</div>
