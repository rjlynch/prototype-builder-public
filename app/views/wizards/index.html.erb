<div class="govuk-width-container">
  <main class="govuk-main-wrapper" id="main-content">
    <h1 class="govuk-heading-l">Your wizards</h1>

    <%= button_to "New wizard", wizards_path, class: "govuk-button" %>

    <% if wizards.none? %>
      <p class="govuk-body">You have not created any wizards yet.</p>
    <% else %>
      <ul class="govuk-list">
        <% wizards.each do |wizard| %>
          <li>
            <%= link_to wizard.name, edit_page_path(wizard.pages.first), class: "govuk-link" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </main>
</div>
