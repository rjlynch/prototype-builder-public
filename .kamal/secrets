# Secrets referenced from config/deploy.yml. Safe to commit: no raw credentials,
# only lookups. DO NOT ENTER RAW CREDENTIALS HERE.
#
# Kamal does its own ${VAR} interpolation and does NOT support bash's
# ${VAR:-default} syntax — it mangles it. So we read the env var *inside* a
# $(...) command substitution with `printenv`, which Kamal passes through to a
# real shell: env var wins when set (CI), otherwise the local fallback runs.

# Registry password: the workflow's GITHUB_TOKEN in CI, your gh CLI token locally.
KAMAL_REGISTRY_PASSWORD=$(printenv KAMAL_REGISTRY_PASSWORD || gh auth token)

# Rails master key: a repo secret in CI (config/master.key is gitignored and
# absent on the runner), the local file otherwise.
RAILS_MASTER_KEY=$(printenv RAILS_MASTER_KEY || cat config/master.key)
