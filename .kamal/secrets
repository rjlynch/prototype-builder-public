# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Registry password.
#   - In CI we export KAMAL_REGISTRY_PASSWORD (the workflow's GITHUB_TOKEN).
#   - Locally it falls back to your gh CLI oauth token, so manual deploys work
#     without setting anything up.
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:-$(gh config get -h github.com oauth_token)}

# Rails master key.
#   - In CI we export RAILS_MASTER_KEY (a repo secret); config/master.key is
#     gitignored and absent on the runner.
#   - Locally it falls back to the committed-out config/master.key file.
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key)}
